{% extends "base.html" %}

{% block title %}Resources | CCCGJ{% endblock %}

{% block nav_resources %}active{% endblock %}

{% block content %}
    <section class="resources-hero section-padding">
        <div class="container">
            <h1 style="font-family: var(--font-heading);">Resources</h1>
            <p>资源</p>
        </div>
    </section>

    <section class="section-padding">
        <div class="container">
            <h2 style="margin-bottom: 20px;">Latest Sermons <span>最新讲道</span></h2>
            
            <div class="carousel-container" style="margin-bottom: 40px;">
                <div class="carousel-wrapper">
                    <div class="carousel-track" style="transform: translateX(-33.3333%);">
<div class="carousel-item" style="flex: 0 0 33.3333%;">
                            <div class="card">
                                <div class="card-body">
                                    <h3 class="card-title"><h3 class="card-title" style="font-family: &quot;Playfair Display&quot;, serif; color: rgb(0, 51, 102); background-color: rgb(255, 255, 255);">骄傲与信望爱 Pride vs Faith, Hope, and Love</h3></h3>
                                    <p><p style="background-color: rgb(255, 255, 255);">Date: Jun 7, 2026</p></p>
                                    <p>Speaker: CCCGJ Media</p>
                                    <br>
                                    <a href="https://www.youtube.com/watch?v=weLX_U-gDMk" target="_blank" class="btn btn-secondary youtube-btn">
                                        <i class="fab fa-youtube"></i> Watch on YouTube
                                    </a>
                                </div>
                            </div>
                        </div>
<div class="carousel-item" style="flex: 0 0 33.3333%;">
                            <div class="card">
                                <div class="card-body">
                                    <h3 class="card-title">赎罪：从神临到人 The Atonement: From God to Man</h3>
                                    <p>Date: Mar 29, 2026</p>
                                    <p>Speaker: CCCGJ Media</p>
                                    <br>
                                    <a href="https://www.youtube.com/watch?v=_7cP17K5Lsw" target="_blank" class="btn btn-secondary youtube-btn">
                                        <i class="fab fa-youtube"></i> Watch on YouTube
                                    </a>
                                </div>
                            </div>
                        </div>
<div class="carousel-item" style="flex: 0 0 33.3333%;">
                            <div class="card">
                                <div class="card-body">
                                    <h3 class="card-title">上帝给人类的兆头 God's Sign to Humanity</h3>
                                    <p>Date: Mar 22, 2026</p>
                                    <p>Speaker: CCCGJ Media</p>
                                    <br>
                                    <a href="https://www.youtube.com/watch?v=PM-Ra9qKeb8" target="_blank" class="btn btn-secondary youtube-btn">
                                        <i class="fab fa-youtube"></i> Watch on YouTube
                                    </a>
                                </div>
                            </div>
                        </div>
<div class="carousel-item" style="flex: 0 0 33.3333%;">
                            <div class="card">
                                <div class="card-body">
                                    <h3 class="card-title">我看见了主 I Saw the LORD</h3>
                                    <p>Date: Mar 13, 2026</p>
                                    <p>Speaker: CCCGJ Media</p>
                                    <br>
                                    <a href="https://www.youtube.com/watch?v=HU6G1S_AFDo" target="_blank" class="btn btn-secondary youtube-btn">
                                        <i class="fab fa-youtube"></i> Watch on YouTube
                                    </a>
                                </div>
                            </div>
                        </div>
<div class="carousel-item" style="flex: 0 0 33.3333%;">
                            <div class="card">
                                <div class="card-body">
                                    <h3 class="card-title">上帝的葡萄园 God's Vineyard</h3>
                                    <p>Date: Mar 1, 2026</p>
                                    <p>Speaker: CCCGJ Media</p>
                                    <br>
                                    <a href="https://www.youtube.com/watch?v=KQX1Eb54PAM" target="_blank" class="btn btn-secondary youtube-btn">
                                        <i class="fab fa-youtube"></i> Watch on YouTube
                                    </a>
                                </div>
                            </div>
                        </div>
<div class="carousel-item" style="flex: 0 0 33.3333%;">
                            <div class="card">
                                <div class="card-body">
                                    <h3 class="card-title">《虚假的依靠》之二：政治领袖 False Reliance Part Two Political Leaders</h3>
                                    <p>Date: Feb 22, 2026</p>
                                    <p>Speaker: CCCGJ Media</p>
                                    <br>
                                    <a href="https://www.youtube.com/watch?v=uByZK03NmVg" target="_blank" class="btn btn-secondary youtube-btn">
                                        <i class="fab fa-youtube"></i> Watch on YouTube
                                    </a>
                                </div>
                            </div>
                        </div>
</div>
                </div>

                <!-- Carousel controls -->
                <button class="carousel-btn carousel-btn-prev" id="prevBtn">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="carousel-btn carousel-btn-next" id="nextBtn">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
            
            <h2 style="margin-bottom: 40px;">Useful Resources <span>有用的资源</span></h2>
            
            <div class="resource-grid">
                <!-- Tile 1 -->
                <a href="https://g3min.org/" class="resource-tile" target="_blank">
                    <div class="resource-icon"><img src="/static/images/G3-web-banner-scaled.png" onerror="this.src='/static/images/G3-web-banner-scaled.png'" alt="G3 Ministries"></div>
                    <div class="resource-title">G3 Ministry</div>
                    <div class="resource-subtitle">G3 Ministries exists to glorify God by educating, encouraging, and equipping God's people with biblical truth for faithful living...</div>
                    <div class="resource-arrow">View <i class="fas fa-arrow-right"></i></div>
                </a>

                <!-- Tile 2 -->
                <a href="https://founders.org/" class="resource-tile" target="_blank">
                    <div class="resource-icon"><img src="/static/images/fm-logo-blue.png" onerror="this.src='/static/images/fm-logo-blue.png'" alt="Founders Ministries"></div>
                    <div class="resource-title">Founders Ministries</div>
                    <div class="resource-subtitle">Founders Ministries is committed to encouraging the recovery of the gospel and the biblical reformation of local churches.</div>
                    <div class="resource-arrow">View <i class="fas fa-arrow-right"></i></div>
                </a>

                <!-- Tile 3 -->
                <a href="https://read.faithconnect.us/" class="resource-tile" target="_blank">
                    <div class="resource-icon"><img src="/static/images/faithconnect-logo.jpg" onerror="this.src='/static/images/faithconnect-logo.jpg'" alt="FaithConnect"></div>
                    <div class="resource-title">Read Faithfully</div>
                    <div class="resource-subtitle">ReadFaithfully exists to glorify God by faithfully bringing the Word of God to people who need it.</div>
                    <div class="resource-arrow">View <i class="fas fa-arrow-right"></i></div>
                </a>

                <!-- Tile 4 -->
                <a href="https://www.9marks.org/" class="resource-tile" target="_blank">
                    <div class="resource-icon"><img src="/static/images/9marks.png" onerror="this.src='/static/images/9marks.png'" alt="9 Marks"></div>
                    <div class="resource-title">健康教会九标志</div>
                    <div class="resource-subtitle">Helping pastors build healthy churches.</div>
                    <div class="resource-arrow">View <i class="fas fa-arrow-right"></i></div>
                </a>
                
                <!-- Tile 5 -->
                <a href="https://www.gty.org/" class="resource-tile" target="_blank">
                    <div class="resource-icon"><img src="/static/images/gty.png" onerror="this.src='/static/images/gty.png'" alt="GTY"></div>
                    <div class="resource-title">Grace To You</div>
                    <div class="resource-subtitle">From its beginning, Grace to You has never been about a building. The focus has been on what we do and not where we do it.</div>
                    <div class="resource-arrow">View <i class="fas fa-arrow-right"></i></div>
                </a>

                <!-- Tile 6 (Placeholder) -->
                <a href="https://www.desiringgod.org/" class="resource-tile" target="_blank">
                    <div class="resource-icon"><img src="https://lh3.googleusercontent.com/d/16-jacmMvKGg-TNLFL9-2GqA5Cr-SzMht" onerror="this.src='https://lh3.googleusercontent.com/d/16-jacmMvKGg-TNLFL9-2GqA5Cr-SzMht'" alt="Desiring God"></div>
                    <div class="resource-title">Desiring God</div>
                    <div class="resource-subtitle">Everything we create and distribute here at Desiring God exists to guide you toward everlasting joy in Jesus Christ.</div>
                    <div class="resource-arrow">View <i class="fas fa-arrow-right"></i></div>
                </a>
            </div>
        </div>
    </section>

    <button id="back-to-top-btn" title="Go to top" aria-label="Back to top"><i class="fa-solid fa-angle-up"></i></button>
{% endblock %}
                